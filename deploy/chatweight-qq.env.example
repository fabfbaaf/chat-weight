# Copy to /etc/chatweight/qq.env with restrictive file permissions.
# HTTP client event token in NapCat. NapCat turns this into X-Signature.
CHATWEIGHT_ONEBOT_SECRET=replace-with-event-token
# HTTP server API token in NapCat; required for auto-send.
CHATWEIGHT_ONEBOT_TOKEN=replace-with-api-token
# QQ number logged into NapCat; checked before every automatic send.
CHATWEIGHT_QQ_SELF_ID=replace-with-own-qq-number
# Comma-separated friend QQ numbers for 12-hour proactive messages only.
CHATWEIGHT_QQ_PROACTIVE_ALLOW_IDS=replace-with-friend-qq-number
# Fill an OpenAI-compatible LLM endpoint and exact model names.
CHATWEIGHT_AI_BASE_URL=https://model-provider.example/v1
CHATWEIGHT_AI_KEY=replace-with-model-key
CHATWEIGHT_JUDGE_MODEL=replace-with-judge-model
CHATWEIGHT_REPLY_MODEL=replace-with-reply-model
